{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zk-jam.archelabs.dev/schema/pvm-openvm-benchmark-v1.schema.json",
  "title": "PVM -> OpenVM Benchmark v1",
  "type": "object",
  "required": ["schema_version", "environment", "semantic_gate", "workloads", "comparison_status", "comparison_complete"],
  "properties": {
    "schema_version": {"const": "pvm-openvm-benchmark-v1"},
    "environment": {"type": "object"},
    "semantic_gate": {"$ref": "#/$defs/semantic_gate"},
    "workloads": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/workload"}
    },
    "comparison_status": {"enum": ["complete", "partial", "unavailable"]},
    "comparison_complete": {"type": "boolean"}
  },
  "$defs": {
    "semantic_gate": {
      "type": "object",
      "required": ["complete", "cases"],
      "properties": {
        "complete": {"type": "boolean"},
        "cases": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/semantic_case"}
        }
      }
    },
    "semantic_case": {
      "type": "object",
      "required": [
        "workload", "case", "input", "reference_output_hex",
        "direct_openvm_guest_output_hex", "generated_guest_output_hex",
        "direct_pvm_lowering_output_hex", "direct_openvm_guest_match",
        "generated_guest_match", "direct_pvm_lowering_match",
        "public_values_len", "reserved_bytes_zero", "complete"
      ],
      "properties": {
        "workload": {"type": "string"},
        "case": {"type": "string"},
        "input": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
        "reference_output_hex": {"type": "string"},
        "direct_openvm_guest_output_hex": {"type": "string"},
        "generated_guest_output_hex": {"type": "string"},
        "direct_pvm_lowering_output_hex": {"type": "string"},
        "direct_openvm_guest_match": {"type": "boolean"},
        "generated_guest_match": {"type": "boolean"},
        "direct_pvm_lowering_match": {"type": "boolean"},
        "public_values_len": {"const": 128},
        "reserved_bytes_zero": {"type": "boolean"},
        "complete": {"type": "boolean"}
      }
    },
    "side": {
      "type": "object",
      "required": [
        "build_ns", "transpile_ns", "lowering_ns", "app_keygen_ns", "agg_keygen_ns",
        "keygen_ns", "execute_ns", "prove_ns", "verify_ns", "proof_bytes",
        "peak_rss_bytes", "executable_bytes", "serialized_executable_bytes",
        "public_values_len", "output_hex", "proof_verified", "error"
      ],
      "properties": {
        "build_ns": {"type": ["integer", "null"]},
        "transpile_ns": {"type": ["integer", "null"]},
        "lowering_ns": {"type": ["integer", "null"]},
        "app_keygen_ns": {"type": ["integer", "null"]},
        "agg_keygen_ns": {"type": ["integer", "null"]},
        "keygen_ns": {"type": ["integer", "null"]},
        "execute_ns": {"type": ["integer", "null"]},
        "prove_ns": {"type": ["integer", "null"]},
        "verify_ns": {"type": ["integer", "null"]},
        "proof_bytes": {"type": ["integer", "null"]},
        "peak_rss_bytes": {"type": ["integer", "null"]},
        "executable_bytes": {"type": ["integer", "null"]},
        "serialized_executable_bytes": {"type": ["integer", "null"]},
        "public_values_len": {"type": ["integer", "null"]},
        "output_hex": {"type": ["string", "null"]},
        "proof_verified": {"type": "boolean"},
        "error": {"type": ["string", "null"]}
      }
    },
    "ratio_set": {
      "type": "object",
      "required": ["execute", "prove", "keygen", "verify", "proof_size", "peak_rss"],
      "properties": {
        "execute": {"type": ["number", "null"]},
        "prove": {"type": ["number", "null"]},
        "keygen": {"type": ["number", "null"]},
        "verify": {"type": ["number", "null"]},
        "proof_size": {"type": ["number", "null"]},
        "peak_rss": {"type": ["number", "null"]}
      }
    },
    "ratios": {
      "type": "object",
      "required": ["generated_over_direct", "direct_pvm_lowering_over_direct", "direct_pvm_lowering_over_generated"],
      "properties": {
        "generated_over_direct": {"$ref": "#/$defs/ratio_set"},
        "direct_pvm_lowering_over_direct": {"$ref": "#/$defs/ratio_set"},
        "direct_pvm_lowering_over_generated": {"$ref": "#/$defs/ratio_set"}
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "workload", "input", "reference_output_hex", "source_pvm_instruction_count",
        "generated_ir_instruction_count", "translation_ns", "emission_ns",
        "lowered_openvm_instruction_count", "direct_openvm_guest", "generated_guest",
        "direct_pvm_lowering", "ratios", "semantics_match"
      ],
      "properties": {
        "workload": {"enum": ["arithmetic", "branch", "memory-16k"]},
        "input": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}},
        "reference_output_hex": {"type": "string"},
        "source_pvm_instruction_count": {"type": "integer", "minimum": 0},
        "generated_ir_instruction_count": {"type": "integer", "minimum": 0},
        "translation_ns": {"type": ["integer", "null"]},
        "emission_ns": {"type": ["integer", "null"]},
        "lowered_openvm_instruction_count": {"type": ["integer", "null"]},
        "direct_openvm_guest": {"$ref": "#/$defs/side"},
        "generated_guest": {"$ref": "#/$defs/side"},
        "direct_pvm_lowering": {"$ref": "#/$defs/side"},
        "ratios": {"$ref": "#/$defs/ratios"},
        "semantics_match": {"type": "boolean"}
      }
    }
  }
}
