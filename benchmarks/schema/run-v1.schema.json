{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZK-JAM M2 benchmark sample",
  "type": "object",
  "required": ["schema_version", "run_id", "benchmark", "backend", "sample_index", "warmup", "total_time_ns"],
  "properties": {
    "schema_version": {"const": "run-v1"},
    "run_id": {"type": "string"},
    "benchmark": {"type": "string"},
    "backend": {"enum": ["cpu", "gpu"]},
    "sample_index": {"type": "integer"},
    "warmup": {"type": "boolean"},
    "build_time_ns": {"type": ["integer", "null"]},
    "transpile_time_ns": {"type": ["integer", "null"]},
    "keygen_time_ns": {"type": ["integer", "null"]},
    "execute_time_ns": {"type": ["integer", "null"]},
    "prove_time_ns": {"type": ["integer", "null"]},
    "verify_time_ns": {"type": ["integer", "null"]},
    "total_time_ns": {"type": "integer"},
    "executable_size_bytes": {"type": ["integer", "null"]},
    "proof_size_bytes": {"type": ["integer", "null"]},
    "peak_rss_bytes": {"type": ["integer", "null"]},
    "openvm_metrics": {"type": "object"},
    "public_output_hex": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  }
}
