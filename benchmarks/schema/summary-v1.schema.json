{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZK-JAM M2 benchmark summary",
  "type": "object",
  "required": ["schema_version", "run_id", "backend", "disclaimer", "metrics_ns", "sample_counts"],
  "properties": {
    "schema_version": {"const": "summary-v1"},
    "run_id": {"type": "string"},
    "backend": {"enum": ["cpu", "gpu"]},
    "disclaimer": {"type": "string"},
    "metrics_ns": {"type": "object"},
    "sample_counts": {"type": "object"}
  }
}
