{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZK-JAM benchmark environment v2",
  "type": "object",
  "required": [
    "schema_version", "run_id", "git_commit", "git_dirty", "os", "arch", "cpu",
    "logical_cpus", "memory_bytes", "kernel", "rustc_version", "cargo_version",
    "build_profile", "backend", "openvm_version", "openvm_revision", "security_bits",
    "openvm_config_hash", "guest_toolchain", "rss_scope", "rss_includes_keygen", "rss_method"
  ],
  "properties": {
    "schema_version": {"const": "environment-v2"},
    "run_id": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "git_dirty": {"type": "boolean"},
    "os": {"type": "string"},
    "arch": {"type": "string"},
    "cpu": {"type": ["string", "null"]},
    "logical_cpus": {"type": ["integer", "null"], "minimum": 1},
    "memory_bytes": {"type": ["integer", "null"], "minimum": 0},
    "kernel": {"type": ["string", "null"]},
    "rustc_version": {"type": ["string", "null"]},
    "cargo_version": {"type": ["string", "null"]},
    "build_profile": {"enum": ["debug", "release"]},
    "backend": {"enum": ["cpu", "gpu"]},
    "openvm_version": {"type": "string"},
    "openvm_revision": {"type": "string"},
    "security_bits": {"type": "integer", "minimum": 1},
    "openvm_config_hash": {"type": ["string", "null"]},
    "guest_toolchain": {"type": "string"},
    "rss_scope": {"enum": ["sample", "benchmark-case", "whole-run"]},
    "rss_includes_keygen": {"type": "boolean"},
    "rss_method": {"type": "string"}
  },
  "additionalProperties": false
}
