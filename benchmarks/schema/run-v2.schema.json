{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZK-JAM benchmark sample v2",
  "type": "object",
  "required": [
    "schema_version", "run_id", "benchmark", "case", "backend", "sample_index",
    "warmup", "success", "build_time_ns", "transpile_time_ns", "keygen_time_ns",
    "execute_time_ns", "prove_time_ns", "verify_time_ns", "total_time_ns",
    "proof_payload_size_bytes", "artifact_size_bytes", "serialized_executable_size_bytes",
    "estimated_executable_size_bytes", "openvm_metrics", "public_output_hex", "error"
  ],
  "properties": {
    "schema_version": {"const": "run-v2"},
    "run_id": {"type": "string"},
    "benchmark": {"type": "string"},
    "case": {"type": "string"},
    "backend": {"enum": ["cpu", "gpu"]},
    "sample_index": {"type": "integer", "minimum": 0},
    "warmup": {"type": "boolean"},
    "success": {"type": "boolean"},
    "build_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "transpile_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "keygen_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "execute_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "prove_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "verify_time_ns": {"type": ["integer", "null"], "minimum": 0},
    "total_time_ns": {"type": "integer", "minimum": 0},
    "proof_payload_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "artifact_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "serialized_executable_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "estimated_executable_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "openvm_metrics": {"type": "object"},
    "public_output_hex": {"type": ["string", "null"]},
    "error": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
